# Development template. setup_backend.sh generates independent signing secrets.
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://careintel:replace-with-database-password@127.0.0.1:5432/careintel
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO_SQL=false
SECRET_KEY=generate-with-setup-script
JWT_SECRET_KEY=generate-with-setup-script
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_ISSUER=careintel
JWT_AUDIENCE=careintel-api
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEPENDENCY_CONNECT_TIMEOUT_SECONDS=10
READINESS_TIMEOUT_SECONDS=10

# Redis is required to run Celery and the outbox dispatcher.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_DEFAULT_QUEUE=careintel_default

# Development providers. For production, configure the external providers below.
LLM_PROVIDER=demo
EMBEDDING_PROVIDER=demo
STT_PROVIDER=demo
TTS_PROVIDER=demo
OCR_PROVIDER=demo

# Production requires Blob, Redis, and all Azure provider credentials.
# AZURE_STORAGE_CONNECTION_STRING=...
AZURE_STORAGE_CONTAINER=careintel-evidence
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# LLM_PROVIDER=azure_openai
# EMBEDDING_PROVIDER=azure_openai
# STT_PROVIDER=azure_openai_diarize
# TTS_PROVIDER=azure_openai
# OCR_PROVIDER=azure_document_intelligence
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=...
# Set each deployment to the name deployed in your Azure resource.
# AZURE_LLM_DEPLOYMENT=...
# AZURE_EMBEDDING_DEPLOYMENT=...
# AZURE_STT_DEPLOYMENT=...
# AZURE_STT_DIARIZE_DEPLOYMENT=...
# AZURE_TTS_DEPLOYMENT=...
